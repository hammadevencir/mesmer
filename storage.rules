rules_version = '2';

// Deploy with: firebase deploy --only storage
service firebase.storage {
  match /b/{bucket}/o {

    // User files (e.g. profile avatars) — only the owning user may write.
    match /users/{userId}/{allPaths=**} {
      allow read: if true;

      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType != null
                   && request.resource.contentType.matches('image/.*');
    }

    // Exercise images, uploaded from the admin panel.
    match /exercises/images/{fileName} {
      allow read: if true;

      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType != null
                   && request.resource.contentType.matches('image/.*');
    }

    // Exercise audio files, uploaded from the admin panel.
    match /exercises/audio/{fileName} {
      allow read: if true;

      allow write: if request.auth != null
                   && request.resource.size < 20 * 1024 * 1024
                   && request.resource.contentType != null
                   && request.resource.contentType.matches('audio/.*');
    }

    // Exercise video files, uploaded from the admin panel.
    match /exercises/video/{fileName} {
      allow read: if true;

      allow write: if request.auth != null
                   && request.resource.size < 200 * 1024 * 1024
                   && request.resource.contentType != null
                   && request.resource.contentType.matches('video/.*');
    }

    // Default: no access unless a more specific rule above matches.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
